# make up creates secrets in ignored .local files.
JWT_SECRET_FILE=.local/jwt.key
# For running Go against an external database, set DATABASE_URL in your shell.
AUTH_MODE=jwt
DB_POOL_SIZE=20
MAX_OPERATIONS=64
MAX_SUBSCRIPTIONS=1024
SUBSCRIPTION_BUFFER=64
RATE_RPS=120
RATE_BURST=240
REQUEST_TIMEOUT=10s
SSE_HEARTBEAT=15s
STREAM_LIFETIME=10m
