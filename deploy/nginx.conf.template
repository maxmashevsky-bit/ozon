worker_processes auto;
events { worker_connections 2048; }
http {
  log_format safe '{"status":$status,"seconds":$request_time,"upstream":"$upstream_addr"}';
  access_log /dev/stdout safe;
  error_log /dev/stderr warn;
  limit_req_zone $server_name zone=service:1m rate=@@GLOBAL_RPS@@r/s;
  upstream apps {
    least_conn;
@@UPSTREAMS@@
    keepalive 64;
  }
  server {
    listen 8080;
    server_name ozon;
    client_max_body_size 1m;
    location = /metrics { return 404; }
    location / {
      proxy_pass http://apps;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 40s;
      proxy_send_timeout 15s;
      proxy_connect_timeout 2s;
      # Retrying POST mutations after a network error can duplicate writes.
      proxy_next_upstream off;
    }
    location = /query {
      limit_req zone=service burst=@@GLOBAL_BURST@@ nodelay;
      limit_req_status 429;
      proxy_pass http://apps;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 40s;
      proxy_send_timeout 15s;
      proxy_connect_timeout 2s;
      proxy_next_upstream off;
    }
  }
}
